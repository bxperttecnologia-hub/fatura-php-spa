# A pasta do site no servidor (aaPanel: Site > Running directory) deve ser /public.
# Se o domínio apontar para aqui por engano, nada fora de public/ é servido
# (.env, app/, vendor/, chaves...).
Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]

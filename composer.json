{
    "name": "bxpert/app-system",
    "description": "Sistema de faturação SPA em PHP",
    "type": "project",
    "require": {
        "php": "^8.2",
        "chillerlan/php-qrcode": "^5.0",
        "dompdf/dompdf": "^3.1",
        "google/apiclient": "^2.18",
        "mpdf/mpdf": "^8.2",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpspreadsheet": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8080 -t public public/router.php"
    },
    "config": {
        "sort-packages": true
    }
}

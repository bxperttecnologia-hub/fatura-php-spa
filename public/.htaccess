Options -Indexes

# Ficheiros que nunca devem ser servidos (ocultos, backups, dumps, chaves, notas)
<FilesMatch "(^\.|\.(bak|sql|log|md|ini|sh|lock|pem|key|txt|dist|orig|yml|yaml|env)$|\.bak[.\-])">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
# Rotas da SPA como /contacts, /items, /stock, /login coincidem com nomes de pastas de endpoints:
# sem isto o Apache redireciona /login -> /login/ antes de a reescrita correr.
DirectorySlash Off

RewriteEngine On

# Scripts de migração (CLI): nunca por HTTP
RewriteRule ^rh/migrations(/|$) - [F,L]

# PDFs de documentos: /api/documents/receipts/5/pdf -> document_pdf.php?path=receipts/5/pdf
RewriteRule ^api/documents/(.*)$ document_pdf.php?path=$1 [L,QSA]

# API: /api/clientes/5 -> api.php?r=clientes/5
RewriteRule ^api/(.*)$ api.php?r=$1 [L,QSA]

# Tudo o que não for ficheiro real devolve o shell
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

<?php
require_once __DIR__ . '/../core/bootstrap.php';

try {
    $pdo = Database::pdo();
} catch (Throwable $e) {
    error_log('DB bootstrap compatibility error: ' . $e->getMessage());
    http_response_code(500);
    echo json_encode(['success' => false, 'message' => 'Erro interno do servidor']);
    exit;
}

# Copie para .env (na raiz do projeto) e preencha. O .env nunca vai para o git.

# GoSMS: códigos de verificação do registo/recuperação e envio das credenciais da conta.
# O remetente (GOSMS_FROM) tem de estar autorizado na GoSMS.
GOSMS_TOKEN=
GOSMS_FROM=
# Só se o cURL do PHP não tiver um bundle CA configurado:
# GOSMS_CA_BUNDLE=C:/xampp/apache/bin/curl-ca-bundle.crt

# API de documentos (bxintelligence-api-rest). Vazio: em produção usa
# https://api-sandibox.bxpert.co.ao; em desenvolvimento os PDFs são gerados pela própria aplicação.
# DOCUMENT_API_BASE_URL=

# AppyPay (pagamento da subscrição) — ver README. Testar só em sandbox.
APPYPAY_ENV=sandbox
APPYPAY_CLIENT_ID_SANDBOX=
APPYPAY_CLIENT_SECRET_SANDBOX=
APPYPAY_RESOURCE_SANDBOX=
APPYPAY_PAYMENT_METHOD_REF_SANDBOX=
APPYPAY_PAYMENT_METHOD_GPO_SANDBOX=
APPYPAY_WEBHOOK_TOKEN=

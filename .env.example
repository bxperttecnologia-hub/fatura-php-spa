# BXpert SPA — copiar para ".env" e preencher. NUNCA versionar o .env.
# Toda a configuração do ambiente vem daqui (app/config/config.php só lê este ficheiro).

# ── Aplicação ─────────────────────────────────────────────────────────────
# production desliga display_errors e o modo debug
APP_ENV=production
APP_TIMEZONE=Africa/Luanda
DEFAULT_COUNTRY_CODE=244

# ── Base de dados MySQL ───────────────────────────────────────────────────
# No aaPanel: utilizador próprio só com acesso a esta BD (não usar root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── API de faturação AGT (agt-facturacao-api) ─────────────────────────────
# No mesmo servidor: http://127.0.0.1:4000 (a API não precisa de estar exposta)
AGT_API_URL=http://127.0.0.1:4000
# Igual ao API_KEY do .env da API
AGT_API_KEY=
# Chave para cifrar segredos dos contribuintes (openssl rand -base64 32). NÃO mudar depois de haver dados.
AGT_KEY_SECRET=
# test (HML) ou production (só com software certificado e credenciais PROD da AGT)
AGT_ENVIRONMENT=test
# Nº de certificação mostrado no rodapé dos documentos
AGT_SOFTWARE_CERTIFICATE=

# ── APIs externas BXpert (IA e documentos) ────────────────────────────────
# Sem /api no fim. Vazio = alternativa por omissão (localhost em desenvolvimento)
AI_API_BASE_URL=
DOCUMENT_API_BASE_URL=
DOCUMENT_API_TOKEN_SECRET=
COMPANY_LOGO_STORAGE=
COMPANY_LOGO_UPLOAD_TOKEN=

# ── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
# 465 = SSL; 587 = STARTTLS
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=BXpert
MAIL_FROM=

# ── SMS ───────────────────────────────────────────────────────────────────
GOSMS_TOKEN=
GOSMS_TOKEN_API=
GOSMS_FROM=
GOSMS_CA_BUNDLE=

# ── Pagamentos AppyPay ────────────────────────────────────────────────────
APPYPAY_ENV=
APPYPAY_CLIENT_ID=
APPYPAY_CLIENT_SECRET=
APPYPAY_RESOURCE=
APPYPAY_RESOURCE_TST=
APPYPAY_PAYMENT_METHOD_REF=
APPYPAY_PAYMENT_METHOD_GPO=
# Token que o webhook da AppyPay tem de enviar (openssl rand -hex 32)
APPYPAY_WEBHOOK_TOKEN=

# Certificados CA para cURL (opcional; normalmente vazio no Linux)
PHP_CURL_CAINFO=
